@context tracker from "./keywords.js"

@external specialize { Identifier } keywords from "./keywords.js" {
  Import,
  Export,
  From,
  As,
  Globals,
  Extensions,
  Includes,
  Breed,
  To,
  ToReport,
  End,
  Own,
  Command,
  Reporter,
  Var,
  Constant
}

@skip { space | Comment }

@top Program { declaration* procedure* }

declaration {
  Import Identifier (As Identifier)? |
  Import OpenBracket (Identifier | Identifier As Identifier)* CloseBracket From Identifier |
  Export OpenBracket Identifier* CloseBracket |
  (Globals | Own) OpenBracket AlwaysVar* CloseBracket |
  Extensions OpenBracket Identifier* CloseBracket |
  Includes OpenBracket String* CloseBracket |
  Breed OpenBracket AlwaysReporter AlwaysReporter CloseBracket
}

procedure { (To AlwaysCommand | ToReport AlwaysReporter) (OpenBracket Identifier+ CloseBracket)? expression* End }

expression {
  "(" expression ")" |
  OpenBracket expression CloseBracket |
  (Command | Reporter) (Identifier | Number | String | Constant)*
}

@tokens {
  space { @whitespace+ }
  Comment { ";" ![\n]* }
  identNoDigit { @asciiLetter | "_" | "." | "?" | "=" | "*" | "!" | "<" | ">" | "#" | "+" | "/" | "%" | "$" | "^" | "'" | "&" | "-" | ":" }
  Identifier { identNoDigit (identNoDigit | @digit)* }
  AlwaysCommand { Identifier }
  AlwaysReporter { Identifier }
  AlwaysVar { Identifier }
  Number { "-"? @digit+ ("." @digit+)? ("e" ("+" | "-") @digit+)? }
  String { '"' (!["\n] | "\\\"")* ('"' | '\n' | @eof) }
  OpenBracket { "[" }
  CloseBracket { "]" }
  @precedence { Number, Identifier }
}
